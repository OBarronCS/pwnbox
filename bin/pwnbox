def list_command():
    if "docker" in CONTAINER_RUNTIME:
        list_command_docker()
    else:
        list_command_podman()

def list_command_podman():
    # Docker + podman have different output formats for ps
    # Podman is a json list
    # Docker is newline-delimited json objects

    # List all containers started with this script
    # We need to do some simple detection
    # docker inspect --format '{{.Name}} {{.Config.Image}}'
    # Also can do a check that a mount or something exists
    # Find some metric to read
    # Maybe the /mount folder?
    result = subprocess.run(
        [
            *CONTAINER_RUNTIME,
            "ps",
            "--all",
            "--format", "json",
            "--no-trunc"
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE
    )

    containers = json.loads(result.stdout)

    filter_command: list[str] = []
    for info in containers:
        container_id = info["Id"]

        is_pwnbox = False
        if PWNBOX_LABEL in info["Labels"]:
            is_pwnbox = True

        if is_pwnbox:
            filter_command += ["--filter", f'id={container_id}']

    if filter_command:
        result = subprocess.run(
            [
                *CONTAINER_RUNTIME,
                "ps",
                "-a",
            ] + filter_command,
        )
        
def list_command_docker():
    
    # Docker + podman have different output formats for ps
    # Podman is a json list
    # Docker is newline-delimited json objects

    # List all containers started with this script
    # We need to do some simple detection
    # docker inspect --format '{{.Name}} {{.Config.Image}}'
    # Also can do a check that a mount or something exists
    # Find some metric to read
    # Maybe the /mount folder?
    result = subprocess.run(
        [
            *CONTAINER_RUNTIME,
            "ps",
            "--all",
            "--format", "json",
            "--no-trunc"
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE
    )

    containers = [json.loads(x) for x in result.stdout.split(b"\n") if x]

    filter_command: list[str] = []
    for info in containers:
        container_id = info["ID"]

        mounts = info["Mounts"]
        if not mounts:
            continue
        
        is_pwnbox = False
        if PWNBOX_LABEL in info["Labels"]:
            is_pwnbox = True

        if is_pwnbox:
            filter_command += ["--filter", f'id={container_id}']

    if filter_command:
        result = subprocess.run(
            [
                "docker",
                "ps",
                "-a",
            ] + filter_command,
        )



if __name__ == "__main__":
    main()
