def temp(image: str | None, shell: str | None, only_root_user: bool):

    if not shell:
        shell = "/bin/bash"

    image = get_image_name(image)
    hostname = "tmp-pwnbox"


    host_user_id = os.getuid()
    host_user_gid = os.getgid()

    DEFAULT_USER_ID = 1000

    user_exists = False
    
    if not only_root_user:

        container_user_id, container_user_gid = determine_user_id_gid(image)

        if container_user_id is None:
            container_user_id = DEFAULT_USER_ID
            container_user_gid = DEFAULT_USER_ID
        else:
            user_exists = True

        idmap_parameters = f"{host_user_id}-{container_user_id}-1#0-0-1;gids={host_user_gid}-{container_user_gid}-1#0-0-1"
    else:
        container_user_id = 0
        container_user_gid = 0
        # Only map root user on the bind mount
        # Map a bunch of ID's so that the mapping exists over the boundary
        idmap_parameters = "0-0-2000;gids=0-0-2000"

    
    command_run_user_id = 0
    if user_exists:
        command_run_user_id = container_user_id

    if user_exists or only_root_user:
        user_command = shell
    else:
        user_id, username = DEFAULT_USER_ID, "user"

        user_command = f"""

SHELL=/bin/bash
if ! command -v /bin/bash >/dev/null 2>&1;
then
    SHELL=/bin/sh
fi

if command -v useradd >/dev/null 2>&1;
then
    useradd --uid {user_id} --shell $SHELL {username}
elif command -v adduser >/dev/null 2>&1;
then
    adduser --gecos "" -D -u {user_id} {username}
fi

if [ -f "/etc/sudoers" ]; then
    echo "{username} ALL=(ALL) NOPASSWD:ALL" >/etc/sudoers.d/{username} 
    chmod 0440 /etc/sudoers.d/{username}
fi

if getent group sudo >/dev/null 2>&1; then
    usermod -a -G sudo {username}
fi

if getent group wheel >/dev/null 2>&1; then
    usermod -a -G wheel {username}
fi

exec su -s {shell} - {username}
"""
    
    result = subprocess.run(
        [
            *CONTAINER_RUNTIME,
            "run",
            "--label", "pwnbox=true",
            "--privileged",
            "-it",
            "--rm",
            "--network", "host",
            "--hostname", hostname,
            "--add-host",f"{hostname}:127.0.0.1",
            "-u", f"{command_run_user_id}:{command_run_user_id}",
            "-w", "/mount/",
            "--mount",f"type=bind,source={os.getcwd()},destination=/mount/,idmap=uids={idmap_parameters}",
            image,
            "/bin/sh",
            "-c", user_command
        ]
    )

def pull():

    current_image = get_image_name(None)
    if current_image.endswith("full"):
        subprocess.run(
            [
                *CONTAINER_RUNTIME,
                "pull",
                f"{DEFAULT_IMAGE}:full"
            ]
        )
    else:
        subprocess.run(
            [
                *CONTAINER_RUNTIME,
                "pull",
                f"{DEFAULT_IMAGE}:latest"
            ]
        )


def config(args):
    if args.config_subcommand == "show":
        print_config()
    elif args.config_subcommand == "set":
        # Look for things to set
        image = args.image
        use_slim = args.use_slim
        use_full = args.use_full

        config = configparser.ConfigParser()

        config.read(CONFIG_FILE_PATH)

        try:
            config.add_section("config")
        except configparser.DuplicateSectionError:
            pass

        image_to_set: str|None = None

        if use_slim:
            config["config"]["image"] = f"{DEFAULT_IMAGE}"
        elif use_full:
            config["config"]["image"] = f"{DEFAULT_IMAGE}:full"
        elif image:
            config["config"]["image"] = args.image

        with open(CONFIG_FILE_PATH, "w") as f:
            config.write(f)
        
        print("Config file modified\n")
        print_config()


    else:
        print(f"Location of config file: {CONFIG_FILE_PATH}")


def print_config():
    if os.path.isfile(CONFIG_FILE_PATH):
        os.system(f"cat {CONFIG_FILE_PATH}")
    else:
        print("Config file not yet created")
        print(f"Default image: {DEFAULT_IMAGE_AND_TAG}")


def update():
    print("Running 'git pull' to get latest version")
    os.system(f"cd {BASE_DIRECTORY} && git pull")

