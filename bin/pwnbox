#!/usr/bin/env python3

import argparse
import json
import subprocess
import os
from pathlib import Path
import sys
import pathlib
import configparser
# This import messes with terminal settings, makes cursor disappear
# from pwn import *

# context.terminal = ['tmux', 'splitw', '-h', '-l', '75%']
# CONTAINER_REGISTRY = "ghcr.io/obarroncs"
# CONTAINER_NAME = "pwnbox"

DEFAULT_IMAGE = "ghcr.io/obarroncs/pwnbox"
DEFAULT_TAG = "latest"
DEFAULT_IMAGE_AND_TAG = f"{DEFAULT_IMAGE}:{DEFAULT_TAG}"

CONFIG_FILE_NAME = ".pwnbox.conf"
CONFIG_FILE_PATH = Path.home() / CONFIG_FILE_NAME

BASE_DIRECTORY = Path(os.path.dirname(os.path.abspath(__file__))).parent.absolute()

PWNBOX_LABEL = "pwnbox"
CONTAINER_RUNTIME = ["sudo","podman"]

def main():

    parser = argparse.ArgumentParser(
        description="Command line interface for pwnbox"
    )

    toplevel_parser = parser.add_subparsers(dest="command", help="Sub-commands")

    # Create
    create_parser = toplevel_parser.add_parser("create")
    create_parser.add_argument("name")
    create_parser.add_argument("--image", "-i", dest="image", default=None, required=False, help="Choose image")
    create_parser.add_argument("-v", dest="volumes", nargs='*', default=[], action="extend", help="Add mounts")
    create_parser.add_argument("--shell", dest="shell",required=False,default=None)
    create_parser.add_argument("-r", dest="only_root_user",action="store_true", required=False,default=False)

    # Enter
    enter_parser = toplevel_parser.add_parser("enter")
    enter_parser.add_argument("name")
    enter_parser.add_argument("-u", dest="user",required=False,default=None)
    enter_parser.add_argument("--shell", dest="shell",required=False,default=None)

    # Remove
    remove_parser = toplevel_parser.add_parser("remove",aliases=["rm","kill"])
    remove_parser.add_argument("names", nargs="+")

    # Debug
    remove_parser = toplevel_parser.add_parser("gdb",aliases=["debug"])
    remove_parser.add_argument("name")

    # Temp
    remove_parser = toplevel_parser.add_parser("temp",aliases=["tmp"])
    remove_parser.add_argument("--image", dest="image", default=None, required=False, help="Choose image")
    remove_parser.add_argument("--shell", dest="shell",required=False,default=None)
    remove_parser.add_argument("-r", dest="only_root_user",action="store_true", required=False,default=False)

    # Pull
    pull_parser = toplevel_parser.add_parser("pull")

    # Config
    config_parser = toplevel_parser.add_parser("config", description="Set config settings")
    config_subparsers = config_parser.add_subparsers(dest="config_subcommand")
    # Config show
    config_show_parser = config_subparsers.add_parser("show")
    # Config set
    config_set_parser = config_subparsers.add_parser("set")
    config_set_parser.add_argument("--image", dest="image", default=None, required=False, help="Set default image")
    config_set_parser.add_argument("--use-slim", dest="use_slim", action="store_true", default=False, required=False, help="Use slim version of default image")
    config_set_parser.add_argument("--use-full", dest="use_full", action="store_true", default=None, required=False, help="Use full version of default image")

    
    
    # List
    list_parser = toplevel_parser.add_parser("list",aliases=["ls"])

    # Update
    update_parser = toplevel_parser.add_parser("update",aliases=["upgrade"])

    """
    User qemu to attach to a binary.
    """

    # Parse arguments
    args = parser.parse_args()


    if args.command == "create":
        create(args.name, args.volumes, args.image, args.shell, args.only_root_user)
    elif args.command == "enter":
        enter(args.name, args.user, args.shell)
    elif args.command in {"remove","rm","kill"}:
        remove(args.names)
    elif args.command in {"gdb","debug"}:
        debug_command(args.name)
    elif args.command in {"temp","tmp"}:
        temp(args.image, args.shell, args.only_root_user)
    elif args.command in {"list","ls"}:
        list_command()
    elif args.command == "pull":
        pull()
    elif args.command == "config":
        config(args)
    elif args.command in {"update", "upgrade"}:
        update()
    else:
        print("Unknown command")
        parser.print_help()


def get_image_name(image: str | None) -> str:
    """
    Return the image that will be used on the next `pwnbox create`.
    """
    if image is not None:
        return image
    else:
        config = configparser.ConfigParser()
        try:
            with open(CONFIG_FILE_PATH) as f:
                config.read_file(f)
                image = config["config"]["image"]
                return image
        except:
            # Use the default name, in this case
            return DEFAULT_IMAGE_AND_TAG


def determine_user_id_gid(image: str) -> tuple[int,int]:

    test = subprocess.run(
        [
            *CONTAINER_RUNTIME,
            "image",
            "inspect",
            f"{image}"
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )

    if test.returncode != 0:
        print(f"Pulling image '{image}'")

        subprocess.run(
            [
                *CONTAINER_RUNTIME,
                "pull",
                f"{image}"
            ]
        )

        test = subprocess.run(
            [
                *CONTAINER_RUNTIME,
                "image",
                "inspect",
                f"{image}"
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        

    container = json.loads(test.stdout)

    if len(container) == 1:
        labels = container[0]["Labels"]

        if labels:
            user_id = labels.get("PWNBOX_USER_ID", None)
            if user_id is not None:
                return user_id, user_id

        print("PWNBOX_USER_ID label not found")

    # User ID not specified in an image label, determine it automatically

    test = subprocess.run(
        [
            *CONTAINER_RUNTIME,
            "run",
            "--rm",
            "--entrypoint", "cat",
            f"{image}",
            "/etc/passwd"
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    
    if test.returncode == 0:
        lines = test.stdout.splitlines()
        
        user_info: list[tuple[str,int,int]] = []

        for line in lines:
            text = line.decode("utf-8")
            username, x, uid, gid, *_ = text.split(":")
            user_info.append((username, int(uid), int(gid)))

        user_info = list(filter(
            lambda x: x[1] >= 1000 and x[1] < 2000,
            user_info
        ))

        user_info.sort(key=lambda x: x[1])

        if len(user_info) > 0:
            auto_detected_user: tuple[str,int,int] = user_info[-1]
            username, uid, gid = auto_detected_user
            return uid, gid
        else:
            print("No default distro user found")

    return None, None

def create(name: str, volumes: list[str], image: str | None, shell: str | None, only_root_user: bool):

    test = subprocess.run(
        [
            *CONTAINER_RUNTIME,
            "container",
            "inspect",
            f"{name}"
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )

    if test.returncode == 0:
        print(f"A docker container with name '{name}' already exists")
        sys.exit(1)

    image = get_image_name(image)

    print(f"Creating pwnbox with image '{image}'")

    extra_mounts: list[str] = []

    for v in volumes:
        try:
            a,b = v.split(":",maxsplit=1)
        except ValueError as e:
            print("A mount requires a ':'")
            sys.exit(1)

        host_path = pathlib.Path(a).resolve()
        
        extra_mounts += ["-v",f"{host_path}:{b}"]

    create_podman(name, extra_mounts, image, only_root_user)
    # hostname = f"pwnbox-{name}"
    # result = subprocess.run(
    #     [
    #         "docker",
    #         "run",
    #         "--label", "pwnbox=true",
    #         "--privileged",
    #         "-it",
    #         "--network", "host",
    #         "--hostname", hostname,
    #         "--add-host",f"{hostname}=127.0.0.1",
    #         "-u", f"{os.getuid()}:{os.getgid()}",
    #         "-d",
    #         "-w", "/mount/",
    #         "-v", f"{os.getcwd()}:/mount/",
    #         *extra_mounts,
    #         "--name", f"{name}",
    #         image,
    #         "/bin/bash",
    #     ]
    # )

    enter(name, shell=shell)

def create_podman(name: str, extra_mounts: list[str], image: str, only_root_user: bool):

    hostname = f"pwnbox-{name}"

    host_user_id = os.getuid()
    host_user_gid = os.getgid()

    DEFAULT_USER_ID = 1000

    created_user = False
    
    if not only_root_user:

        container_user_id, container_user_gid = determine_user_id_gid(image)

        if container_user_id is None:
            created_user = True
            container_user_id = DEFAULT_USER_ID
            container_user_gid = DEFAULT_USER_ID

        idmap_parameters = f"{host_user_id}-{container_user_id}-1#0-0-1;gids={host_user_gid}-{container_user_gid}-1#0-0-1"
    else:
        container_user_id = 0
        container_user_gid = 0
        # Only map root user on the bind mount
        # Map a bunch of ID's so that the mapping exists over the boundary
        idmap_parameters = "0-0-2000;gids=0-0-2000"

    result = subprocess.run(
        [
            *CONTAINER_RUNTIME,
            "run",
            "--label", "pwnbox=true",
            "--privileged",
            "-it",
            "--network", "host",
            "--hostname", hostname,
            "--add-host",f"{hostname}:127.0.0.1",
            "-u", f"{container_user_id}:{container_user_gid}",
            "--passwd=false", # podman by default writes user id to /etc/passwd
            "-d",
            "-w", "/mount/",
            "--mount",f"type=bind,source={os.getcwd()},destination=/mount/,idmap=uids={idmap_parameters}",
            *extra_mounts,
            "--name", f"{name}",
            image,
            # "/bin/bash",
        ]
    )

    # Default user could not be found nor detected, so we create it
    if created_user:
        USERNAME = "user"
        container_create_user(name, DEFAULT_USER_ID, USERNAME)

def container_create_user(container_name: str, user_id: int, username: str):
        print(f"Creating user: '{username}' with UID {user_id}")
        
        # We check for useradd first because sometimes adduser just is a symlink to it
        user_command = f"""

SHELL=/bin/bash
if ! command -v /bin/bash >/dev/null 2>&1;
then
    SHELL=/bin/sh
fi

if command -v useradd >/dev/null 2>&1;
then
    useradd --uid {user_id} --shell $SHELL {username}
elif command -v adduser >/dev/null 2>&1;
then
    adduser --gecos "" -D -u {user_id} {username}
fi

if [ -f "/etc/sudoers" ]; then
    echo "{username} ALL=(ALL) NOPASSWD:ALL" >/etc/sudoers.d/{username} 
    chmod 0440 /etc/sudoers.d/{username}
fi

if getent group sudo >/dev/null 2>&1; then
    usermod -a -G sudo {username}
fi

if getent group wheel >/dev/null 2>&1; then
    usermod -a -G wheel {username}
fi

"""
        result = subprocess.run(
            [
                *CONTAINER_RUNTIME,
                "exec",
                "-u", "root",
                f"{container_name}",
                "/bin/sh",
                "-c", user_command
            ]
        )


def enter(name: str, user: str | None = None, shell: str | None = None):

    if not shell:
        shell = "/bin/bash"

    test = subprocess.run(
        [
            *CONTAINER_RUNTIME,
            "container",
            "inspect",
            f"{name}"
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )

    if test.returncode != 0:
        print(f"A docker container with name '{name}' does not exists")
        sys.exit(1)
    
    docker_info = json.loads(test.stdout)

    running = docker_info[0]["State"]["Running"]

    if not running:
        subprocess.run(
            [
                *CONTAINER_RUNTIME,
                "container",
                "start",
                f"{name}"
            ]
        )

    mount_info = docker_info[0]["Mounts"][0]
    host_dir = mount_info["Source"]

    host_path = pathlib.Path(host_dir).resolve()
    cwd_path = pathlib.Path(os.getcwd()).resolve()

    rel = ""
    try:
        rel = cwd_path.relative_to(host_path)
    except ValueError:
        pass

    user_cli_flags = [] if not user else ["-u", user]

    result = subprocess.run(
        [
            *CONTAINER_RUNTIME,
            "exec",
            "-it",
            "-w", f"/mount/{rel}",
            *user_cli_flags,
            f"{name}",
            shell
        ]
    )

def remove(names: list[str]):
    for name in names:
        print(f"Deleting container '{name}'")

        result = subprocess.run(
            [
                *CONTAINER_RUNTIME,
                "kill",
                f"{name}",
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE
        )
        
        if b" is not running" in result.stderr:
            pass

        result = subprocess.run(
            [
                *CONTAINER_RUNTIME,
                "container",
                "rm",
                f"{name}",
            ]
        )


